@model List<AliMartinCv.Core.DTOS.BlogViewModels.ShowBlogsViewModel>

<section id="blogs" class="blogs-section section py-5" style="margin-top: 0; padding-top: 80px !important;">
    <div class="blogs-galaxy">
        <div class="blogs-stars"></div>
        <div class="blogs-nebula"></div>
    </div>

    <div class="container position-relative z-2">
        <div class="text-center mb-5">
            <h2 class="section-title-cosmic animate__animated animate__fadeIn">Latest Articles</h2>
            <div class="title-line-center mb-4"></div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="category-nav-wrapper mb-5">
                <div class="category-pills">
                    <a href="/blogs" class="pill-btn @(string.IsNullOrEmpty(ViewBag.Category) ? "active" : "")">
                        <i class="fas fa-th-large"></i> All Posts
                    </a>
                    <a href="/blogs?category=technology" class="pill-btn @(ViewBag.Category == "technology" ? "active" : "")">
                        <i class="fas fa-microchip"></i> Technology
                    </a>
                    <a href="/blogs?category=webdev" class="pill-btn @(ViewBag.Category == "webdev" ? "active" : "")">
                        <i class="fas fa-code"></i> Web Dev
                    </a>
                    <a href="/blogs?category=aspnet" class="pill-btn @(ViewBag.Category == "aspnet" ? "active" : "")">
                        <i class="fab fa-microsoft"></i> ASP.NET
                    </a>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var blog in Model)
                {
                    var category = !string.IsNullOrEmpty(blog.BlogSubGroupTitle) ? blog.BlogSubGroupTitle : "Technology";
                    var slug = blog.BlogTitle?.ToLower().Replace(" ", "-") ?? "post";

                    <div class="col-lg-4 col-md-6">
                        <article class="modern-blog-card">
                            <div class="card-image">
                                <img src="/Blog/Thumbs/@blog.BlogThumbnail" alt="@blog.BlogTitle">
                                <div class="category-tag">@category</div>
                            </div>
                            <div class="card-body-cosmic">
                                <div class="card-meta">
                                    <span><i class="far fa-calendar-alt"></i> @blog.BlogPublishDate.ToString("MMM dd, yyyy")</span>
                                    <span><i class="far fa-eye"></i> @blog.Visit</span>
                                </div>
                                <h3 class="card-title">@blog.BlogTitle</h3>
                                <p class="card-text">@blog.BlogShortDescription</p>
                                <a href="/blogs/Blog/@blog.BlogId/@slug" class="read-more-link">
                                    Read Article <i class="fas fa-long-arrow-alt-right"></i>
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<style>
    /* حذف فاصله بین سکشن‌ها */
    #portfolio {
        margin-bottom: 0 !important;
        padding-bottom: 80px !important;
    }

    .blogs-section {
        margin-top: 0 !important;
        background: #0a0a2e; /* هماهنگ با انتهای پورتفولیو */
        position: relative;
    }

    /* استایل جدید دسته‌بندی - تمیز و مدرن */
    .category-nav-wrapper {
        display: flex;
        justify-content: center;
        overflow-x: auto;
        padding-bottom: 10px;
    }

    .category-pills {
        display: inline-flex;
        background: rgba(255, 255, 255, 0.03);
        padding: 6px;
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        gap: 5px;
    }

    .pill-btn {
        padding: 10px 22px;
        border-radius: 50px;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .pill-btn:hover {
            color: white;
            background: rgba(255, 255, 255, 0.05);
        }

        .pill-btn.active {
            background: linear-gradient(135deg, #4e54c8, #8f94fb);
            color: white;
            box-shadow: 0 5px 15px rgba(78, 84, 200, 0.4);
        }

    /* استایل جدید کارت‌ها */
    .modern-blog-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        overflow: hidden;
        height: 100%;
        transition: 0.4s;
    }

        .modern-blog-card:hover {
            transform: translateY(-10px);
            border-color: #8f94fb;
            background: rgba(255, 255, 255, 0.04);
        }

    .card-image {
        position: relative;
        height: 200px;
    }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .category-tag {
        position: absolute;
        bottom: 15px;
        left: 15px;
        background: #8f94fb;
        color: white;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    .card-body-cosmic {
        padding: 25px;
    }

    .card-meta {
        display: flex;
        gap: 15px;
        font-size: 0.8rem;
        color: rgba(255,255,255,0.5);
        margin-bottom: 12px;
    }

    .card-title {
        color: white;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .card-text {
        color: rgba(255,255,255,0.6);
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .read-more-link {
        color: #8f94fb;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
    }

        .read-more-link:hover {
            gap: 15px;
            color: white;
        }

    /* پس‌زمینه ستاره‌ای */
    .blogs-galaxy {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
    }

    .blogs-stars {
        background: url('https://www.transparenttextures.com/patterns/stardust.png');
        opacity: 0.3;
        width: 100%;
        height: 100%;
    }
</style>