<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Particle animation
        const blogCards = document.querySelectorAll('.cosmic-blog-card');

        blogCards.forEach(card => {
            const particles = card.querySelectorAll('.particle');

            particles.forEach((particle, index) => {
                const tx = Math.random() * 100 - 50;
                const ty = Math.random() * -100 - 50;
                particle.style.setProperty('--tx', `${tx}px`);
                particle.style.setProperty('--ty', `${ty}px`);
                particle.style.left = `${Math.random() * 100}%`;
                particle.style.top = `${Math.random() * 100}%`;
            });

            // Filter functionality
            const filterButtons = document.querySelectorAll('.cosmic-filter-btn');
            const currentCategory = '@ViewBag.Category' || 'all';

            filterButtons.forEach(button => {
                if (button.getAttribute('data-filter') === currentCategory) {
                    button.classList.add('active');
                }

                button.addEventListener('click', function(e) {
                    if (!this.getAttribute('href') || this.getAttribute('href') === '#') {
                        e.preventDefault();
                        const filter = this.getAttribute('data-filter');

                        filterButtons.forEach(btn => btn.classList.remove('active'));
                        this.classList.add('active');

                        blogCards.forEach(card => {
                            const category = card.closest('.col').getAttribute('data-category');
                            if (filter === 'all' || category === filter) {
                                card.closest('.col').style.display = 'block';
                                setTimeout(() => {
                                    card.closest('.col').style.opacity = '1';
                                    card.closest('.col').style.transform = 'translateY(0)';
                                }, 100);
                            } else {
                                card.closest('.col').style.opacity = '0';
                                card.closest('.col').style.transform = 'translateY(20px)';
                                setTimeout(() => {
                                    card.closest('.col').style.display = 'none';
                                }, 300);
                            }
                        });
                    }
                });
            });
        });

        // Add scroll animation for cards
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.col[data-category]').forEach(col => {
            col.style.opacity = '0';
            col.style.transform = 'translateY(30px)';
            col.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(col);
        });
    });
</script>