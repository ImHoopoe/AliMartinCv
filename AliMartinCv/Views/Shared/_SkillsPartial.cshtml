<style>
    .skills-section {
        background: #0a0a2e;
        position: relative;
        padding: 60px 0;
    }

    .section-title-cosmic {
        font-size: clamp(2.2rem, 5vw, 2.8rem);
        font-weight: 800;
        color: white;
        margin-bottom: 10px;
    }

    .title-line-center {
        width: 70px;
        height: 4px;
        background: linear-gradient(90deg, #4e54c8, #8f94fb);
        margin: 0 auto;
        border-radius: 2px;
    }

    .skills-category-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        height: 100%;
    }

    .category-title {
        color: white;
        font-weight: 700;
        font-size: 1.25rem;
        margin-bottom: 30px;
        padding-bottom: 10px;
        border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
    }

    .skill-item-new {
        margin-bottom: 25px;
    }

    .skill-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
        font-size: 0.95rem;
    }

    .percent-tag {
        background: rgba(143, 148, 251, 0.15);
        color: #8f94fb;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        border: 1px solid rgba(143, 148, 251, 0.3);
    }

    .progress-cosmic {
        height: 10px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.03);
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 20px;
        position: relative;
        transition: width 2s cubic-bezier(0.22, 1, 0.36, 1);
        overflow: hidden;
    }

        .progress-bar-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: shine-progress 2s infinite linear;
        }

    @@keyframes shine-progress {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }

    .orange-glow {
        background: #ff4d4d;
        box-shadow: 0 0 15px rgba(255, 77, 77, 0.3);
    }

    .blue-glow {
        background: #4facfe;
        box-shadow: 0 0 15px rgba(79, 172, 254, 0.3);
    }

    .yellow-glow {
        background: #f9d423;
        box-shadow: 0 0 15px rgba(249, 212, 35, 0.3);
    }

    .purple-glow {
        background: #a18cd1;
        box-shadow: 0 0 15px rgba(161, 140, 209, 0.3);
    }

    .silver-glow {
        background: #e2ebf0;
        box-shadow: 0 0 15px rgba(226, 235, 240, 0.3);
    }

    .cyan-glow {
        background: #00f2fe;
        box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
    }

    .red-glow {
        background: #f83600;
        box-shadow: 0 0 15px rgba(248, 54, 0, 0.3);
    }

    .green-glow {
        background: #00f260;
        box-shadow: 0 0 15px rgba(0, 242, 96, 0.3);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const observerOptions = { threshold: 0.2 };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const bars = entry.target.querySelectorAll('.progress-bar-fill');
                    const tags = entry.target.querySelectorAll('.percent-tag');

                    bars.forEach(bar => { bar.style.width = bar.getAttribute('data-width'); });
                    tags.forEach(tag => {
                        const target = +tag.getAttribute('data-val');
                        let count = 0;
                        const timer = setInterval(() => {
                            tag.innerText = count + '%';
                            if (count >= target) clearInterval(timer);
                            count++;
                        }, 20);
                    });
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        observer.observe(document.querySelector('#skills'));
    });
</script>