    <style>
        .footer {
            position: relative;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a4a 100%);
            color: white;
            padding-top: 120px;
            overflow: hidden;
            min-height: 500px;
            border-top: 1px solid rgba(78, 84, 200, 0.3);
        }

        /* Galactic Background */
        .footer-galaxy {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .footer-stars, .footer-stars2 {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: transparent;
        }

            .footer-stars::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: radial-gradient(1px 1px at 10% 20%, rgba(255, 255, 255, 0.8), transparent), radial-gradient(1px 1px at 20% 50%, rgba(255, 255, 255, 0.6), transparent), radial-gradient(1px 1px at 30% 80%, rgba(255, 255, 255, 0.7), transparent), radial-gradient(1px 1px at 40% 30%, rgba(255, 255, 255, 0.5), transparent), radial-gradient(1px 1px at 60% 60%, rgba(255, 255, 255, 0.9), transparent), radial-gradient(1px 1px at 70% 40%, rgba(255, 255, 255, 0.6), transparent), radial-gradient(1px 1px at 80% 70%, rgba(255, 255, 255, 0.7), transparent), radial-gradient(1px 1px at 90% 10%, rgba(255, 255, 255, 0.5), transparent);
                background-repeat: repeat;
                background-size: 200px 200px;
                animation: footer-stars 100s linear infinite;
            }

            .footer-stars2::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: radial-gradient(1px 1px at 15% 40%, rgba(143, 148, 251, 0.5), transparent), radial-gradient(1px 1px at 35% 70%, rgba(78, 84, 200, 0.6), transparent), radial-gradient(1px 1px at 55% 20%, rgba(143, 148, 251, 0.4), transparent), radial-gradient(1px 1px at 75% 90%, rgba(78, 84, 200, 0.5), transparent);
                background-repeat: repeat;
                background-size: 300px 300px;
                animation: footer-stars 150s linear infinite reverse;
                opacity: 0.5;
            }

        @@keyframes footer-stars {
            from

        {
            transform: translateY(0);
        }

        to {
            transform: translateY(-200px);
        }

        }

        .footer-nebula {
            position: absolute;
            bottom: 20%;
            right: 10%;
            width: 300px;
            height: 200px;
            background: radial-gradient(circle, rgba(78, 84, 200, 0.1) 0%, transparent 70%);
            filter: blur(30px);
            animation: footer-nebula 20s ease-in-out infinite;
        }

        @@keyframes footer-nebula {
            0%, 100%

        {
            transform: translate(0, 0) scale(1);
            opacity: 0.3;
        }

        50% {
            transform: translate(-20px, 20px) scale(1.1);
            opacity: 0.5;
        }

        }

        .footer-shooting-star {
            position: absolute;
            top: 20%;
            left: -100px;
            width: 2px;
            height: 2px;
            background: white;
            border-radius: 50%;
            box-shadow: 0 0 10px 2px rgba(255, 255, 255, 0.8);
            animation: footer-shooting-star 20s linear infinite;
        }

        @@keyframes footer-shooting-star {
            0%

        {
            transform: translateX(-100px) translateY(0) scale(1);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        90% {
            opacity: 1;
        }

        100% {
            transform: translateX(calc(100vw + 100px)) translateY(100px) scale(0);
            opacity: 0;
        }

        }

        

        @@keyframes waveMove {
            0%

        {
            transform: translateX(0) scaleY(1);
        }

        50% {
            transform: translateX(-25%) scaleY(0.95);
        }

        100% {
            transform: translateX(-50%) scaleY(1);
        }

        }

        /* Footer Content */
        .footer-content {
            position: relative;
            z-index: 2;
            padding-bottom: 60px;
        }

        /* Brand */
        .footer-brand .brand-name {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ffffff 0%, rgba(255, 255, 255, 0.9) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .brand-tagline {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.1rem;
        }

        /* Links */
        .footer-links .row {
            gap: 1.5rem;
        }

        .footer-link {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .footer-link::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
                transition: 0.5s;
            }

            .footer-link:hover {
                color: white;
                background: rgba(78, 84, 200, 0.2);
                transform: translateY(-2px);
            }

                .footer-link:hover::before {
                    left: 100%;
                }

        /* Social Icons */
        .social-title {
            color: white;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .social-icon {
            text-decoration: none;
            position: relative;
        }

        .icon-wrapper {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .icon-glow {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(78, 84, 200, 0.3), rgba(143, 148, 251, 0.3));
            border-radius: 50%;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .social-icon:hover .icon-wrapper {
            transform: translateY(-5px) scale(1.1);
            box-shadow: 0 10px 30px rgba(78, 84, 200, 0.4);
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        }

        .social-icon:hover .icon-glow {
            opacity: 1;
            animation: pulse 1.5s infinite;
        }

        /* Contact Info */
        .footer-contact {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2rem 0;
        }

        .contact-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            color: rgba(255, 255, 255, 0.8);
            transition: all 0.3s ease;
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
        }

            .contact-item:hover {
                color: white;
                background: rgba(78, 84, 200, 0.1);
                transform: translateY(-2px);
            }

        .contact-icon {
            color: var(--primary-color);
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .contact-item:hover .contact-icon {
            color: var(--secondary-color);
            transform: scale(1.2);
        }

        /* Copyright */
        .copyright {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            margin-top: 2rem;
        }

            .copyright .fa-heart {
                animation: heartbeat 1.5s infinite;
            }

        @@keyframes heartbeat {
            0%, 100%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        }

        /* Back to Top Button */
        .footer-back-to-top {
            position: absolute;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 5px 20px rgba(78, 84, 200, 0.4);
            z-index: 3;
        }

            .footer-back-to-top:hover {
                transform: translateY(-5px) scale(1.1);
                box-shadow: 0 10px 30px rgba(78, 84, 200, 0.6);
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .footer

        {
            padding-top: 100px;
        }
        

        .footer-brand .brand-name {
            font-size: 2rem;
        }

        .footer-links .row {
            gap: 1rem;
        }

        .footer-link {
            padding: 0.5rem;
            font-size: 0.9rem;
        }

        .social-icons {
            gap: 1rem;
        }

        .icon-wrapper {
            width: 50px;
            height: 50px;
            font-size: 1.2rem;
        }

        .contact-item {
            flex-direction: column;
            text-align: center;
            gap: 0.5rem;
        }

        .footer-back-to-top {
            width: 40px;
            height: 40px;
            font-size: 1rem;
            bottom: 20px;
            right: 20px;
        }

        }

        @@media (max-width: 576px) {
            .footer-links .row

        {
            justify-content: center;
            gap: 0.5rem;
        }

        .footer-link {
            padding: 0.3rem 0.5rem;
            font-size: 0.8rem;
        }

        .social-icons {
            gap: 0.75rem;
        }

        .icon-wrapper {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const backToTopBtn = document.getElementById('footerBackToTop');

            backToTopBtn.addEventListener('click', function() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });

            window.addEventListener('scroll', function() {
                if (window.pageYOffset > 300) {
                    backToTopBtn.style.opacity = '1';
                    backToTopBtn.style.visibility = 'visible';
                } else {
                    backToTopBtn.style.opacity = '0';
                    backToTopBtn.style.visibility = 'hidden';
                }
            });
        });
    </script>
