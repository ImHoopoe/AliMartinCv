<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ali Martin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4e54c8;
            --secondary: #8f94fb;
            --dark: #0a0a2e;
            --glass: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.15);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--dark);
            color: white;
            overflow-x: hidden;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--dark);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 10px;
        }

        .navbar {
            padding: 20px 0;
            transition: 0.4s ease;
            z-index: 1000;
        }

            .navbar.scrolled {
                background: rgba(10, 10, 46, 0.75) !important;
                backdrop-filter: blur(15px);
                -webkit-backdrop-filter: blur(15px);
                padding: 12px 0;
                border-bottom: 1px solid var(--glass-border);
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
            }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            background: linear-gradient(135deg, #fff 0%, var(--secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            color: rgba(255,255,255,0.7) !important;
            margin: 0 10px;
            font-weight: 500;
            transition: 0.3s;
        }

            .nav-link:hover, .nav-link.active {
                color: #fff !important;
            }

        .nav-btn-cv {
            background: linear-gradient(135deg, var(--primary), var(--secondary)) !important;
            color: #fff !important;
            padding: 8px 22px !important;
            border-radius: 50px !important;
            font-weight: 600 !important;
            box-shadow: 0 4px 15px rgba(78, 84, 200, 0.4);
            border: none !important;
        }

        .navbar-toggler {
            border: 1px solid var(--glass-border) !important;
            background: var(--glass) !important;
            padding: 8px !important;
            border-radius: 8px;
            transition: 0.3s;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(143, 148, 251, 0.4) !important;
            }

            .navbar-toggler i {
                color: #fff !important;
                font-size: 1.4rem;
                display: block;
            }

        @@media (max-width: 991px) {
            .navbar-collapse {
                background: rgba(15, 15, 55, 0.95) !important;
                backdrop-filter: blur(25px) !important;
                -webkit-backdrop-filter: blur(25px) !important;
                position: absolute;
                top: 100%;
                left: 15px;
                right: 15px;
                border-radius: 20px;
                padding: 25px;
                margin-top: 15px;
                border: 1px solid var(--glass-border) !important;
                box-shadow: 0 20px 40px rgba(0,0,0,0.6) !important;
            }

            .navbar-nav {
                align-items: center !important;
            }

            .nav-item {
                width: 100%;
                text-align: center;
            }

            .nav-link {
                padding: 15px 0 !important;
                margin: 0 !important;
                border-bottom: 1px solid rgba(255,255,255,0.08) !important;
                font-size: 1.1rem;
            }

            .nav-item:last-child .nav-link {
                border-bottom: none !important;
            }

            .nav-btn-cv {
                margin-top: 20px !important;
                padding: 12px 35px !important;
                display: inline-flex !important;
                align-items: center;
                gap: 8px;
            }
        }

        main {
            min-height: 100vh;
            padding-top: 80px;
        }

        footer {
            background: rgba(5, 5, 20, 0.8);
            padding: 40px 0;
            border-top: 1px solid var(--glass-border);
            text-align: center;
        }

        @@keyframes footer-stars-anim {
            from {
                transform: translateY(0);
            }

            to {
                transform: translateY(-50%);
            }
        }
    </style>
</head>
<body>

    <nav b-gvfiv2hach="" class="navbar navbar-expand-lg fixed-top" id="mainNav">
        <div class="container">
            <a b-gvfiv2hach="" class="navbar-brand" href="/">Ali Martin</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="fas fa-bars"></i>
            </button>

            <div b-gvfiv2hach="" class="collapse navbar-collapse" id="navbarNav">
                <ul b-gvfiv2hach="" class="navbar-nav ms-auto align-items-center">
                    <li b-gvfiv2hach="" class="nav-item"><a b-gvfiv2hach="" class="nav-link" href="#home">Home</a></li>
                    <li b-gvfiv2hach="" class="nav-item"><a b-gvfiv2hach="" class="nav-link" href="#about">About</a></li>
                    <li b-gvfiv2hach="" class="nav-item"><a b-gvfiv2hach="" class="nav-link" href="#skills">Skills</a></li>
                    <li b-gvfiv2hach="" class="nav-item"><a b-gvfiv2hach="" class="nav-link" href="#experience">Experience</a></li>
                    <li b-gvfiv2hach="" class="nav-item"><a b-gvfiv2hach="" class="nav-link" href="#portfolio">Portfolio</a></li>
                    <li b-gvfiv2hach="" class="nav-item"><a b-gvfiv2hach="" class="nav-link" href="#contact">Contact</a></li>
                    <li b-gvfiv2hach="" class="nav-item">
                        <a b-gvfiv2hach="" class="nav-link nav-btn-cv" href="#" data-bs-toggle="modal" data-bs-target="#portfolioModal">
                            <i b-gvfiv2hach="" class="fas fa-cloud-arrow-down me-1"></i> CV
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p class="mb-0">© @DateTime.Now.Year Ali Martin. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const nav = document.getElementById('mainNav');
        const menu = document.getElementById('navbarNav');
        const bsCollapse = menu ? new bootstrap.Collapse(menu, {toggle: false}) : null;

        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', (e) => {
                const href = link.getAttribute('href');
                if (href.startsWith('#')) {
                    if (window.innerWidth < 992 && bsCollapse) {
                        bsCollapse.hide();
                    }
                }
            });
        });
    </script>
</body>
</html>