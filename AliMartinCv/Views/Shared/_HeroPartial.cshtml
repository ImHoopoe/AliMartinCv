<section id="home" class="hero-section d-flex align-items-center">
    <div class="galaxy-engine">
        <div class="layer-stars"></div>
        <div class="layer-stars-bright"></div>
        <div class="layer-nebula"></div>
    </div>

    <div class="container hero-container">
        <div class="row align-items-center">
            <div class="col-lg-7 hero-text-part">
                <div class="badge-custom animate__animated animate__fadeInLeft">
                    <span>Available for new projects</span>
                </div>

                <h1 class="hero-main-title animate__animated animate__fadeInUp">
                    Hi, I'm <span class="gradient-text">Ali Martin</span>
                </h1>

                <div class="type-wrap animate__animated animate__fadeInUp">
                    <span id="typed-text"></span><span class="cursor-custom">|</span>
                </div>

                <p class="hero-description animate__animated animate__fadeInUp">
                    Building robust back-end systems and stunning front-end experiences with 5+ years of expertise.
                </p>

                <div class="hero-btns animate__animated animate__fadeInUp">
                    <a href="#contact" class="btn-space-primary">
                        <i class="fas fa-rocket me-2"></i>Hire Me
                    </a>
                    <button class="btn-space-outline" data-bs-toggle="modal" data-bs-target="#portfolioModal">
                        <i class="fas fa-file-alt me-2"></i>Resume / CV
                    </button>
