<style>
    /* حفظ دیزاین قبلی + افزودن استایل‌های لازم برای دکمه‌های مودال */
    .hero-section {
        position: relative;
        min-height: 100vh;
        background: #0a0a2e;
        overflow: hidden;
        padding: 120px 0 60px;
        display: flex;
        align-items: center;
    }

    .galaxy-engine {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: radial-gradient(circle at 50% 50%, #16164d 0%, #0a0a2e 100%);
    }

    .layer-stars {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(1px 1px at 20px 30px, #eee, transparent), radial-gradient(1px 1px at 150px 80px, #fff, transparent);
        opacity: 0.3;
        animation: starSlide 150s linear infinite;
    }

    @@keyframes starSlide {
        from {
            transform: translateY(0);
        }

        to {
            transform: translateY(-1000px);
        }
    }

    .hero-container {
        position: relative;
        z-index: 10;
    }

    .gradient-text {
        background: linear-gradient(135deg, #fff 0%, #8f94fb 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }

    .hero-main-title {
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        color: white;
        margin-bottom: 15px;
    }

    .type-wrap {
        font-size: clamp(1.2rem, 4vw, 1.8rem);
        color: #8f94fb;
        margin-bottom: 25px;
        font-weight: 500;
    }

    .hero-description {
        color: rgba(255, 255, 255, 0.7);
        max-width: 550px;
        margin-bottom: 40px;
        line-height: 1.8;
    }

    .hero-btns {
        display: flex;
        gap: 15px;
        position: relative;
        z-index: 20;
    }

    .btn-space-primary, .btn-space-outline {
        padding: 14px 30px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .btn-space-primary {
        background: linear-gradient(135deg, #4e54c8, #8f94fb);
        color: white !important;
        border: none;
        box-shadow: 0 10px 20px rgba(78, 84, 200, 0.3);
    }

    .btn-space-outline {
        background: rgba(255,255,255,0.05);
        color: white !important;
        border: 1px solid rgba(255,255,255,0.2);
        backdrop-filter: blur(5px);
    }

        .btn-space-primary:hover, .btn-space-outline:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(78, 84, 200, 0.4);
            border-color: #8f94fb;
        }

    .profile-main {
        width: min(400px, 85vw);
        border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
        animation: morphing 10s ease-in-out infinite;
        border: 4px solid rgba(255,255,255,0.1);
        z-index: 5;
    }

    @@keyframes morphing {
        0%, 100% {
            border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
        }

        50% {
            border-radius: 50% 50% 33% 67% / 55% 27% 73% 45%;
        }
    }

    .cursor-custom {
        color: #8f94fb;
        animation: blink 0.8s infinite;
    }
    @@keyframes blink {
        50% {
            opacity: 0;
        }
    }

    @@media (max-width: 991px) {
        .hero-section {
            text-align: center;
            padding-top: 100px;
        }

        .hero-description {
            margin: 0 auto 30px;
        }

        .hero-btns {
            flex-direction: column;
        }

        .profile-card {
            padding-top: 2rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Typing Effect
        const textTarget = document.getElementById('typed-text');
        const jobs = ["Full Stack Developer", "Coding Instructor", ".NET Specialist", "AI Enthusiast"];
        let jobIdx = 0, charIdx = 0, isDeleting = false;

        function typeLoop() {
            const fullText = jobs[jobIdx];
            textTarget.textContent = isDeleting ? fullText.substring(0, charIdx - 1) : fullText.substring(0, charIdx + 1);
            charIdx = isDeleting ? charIdx - 1 : charIdx + 1;

            let delay = isDeleting ? 50 : 100;
            if (!isDeleting && charIdx === fullText.length) { delay = 2000; isDeleting = true; }
            else if (isDeleting && charIdx === 0) { isDeleting = false; jobIdx = (jobIdx + 1) % jobs.length; delay = 500; }

            setTimeout(typeLoop, delay);
        }
        typeLoop();
    });
</script>