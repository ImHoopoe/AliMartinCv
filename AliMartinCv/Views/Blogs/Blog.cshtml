@model AliMartinCv.Core.DTOS.BlogViewModels.ShowBlogsViewModel

<section id="blog-details" class="blog-details-section section py-5 mt-5" data-observe aria-labelledby="blog-title">
    <div class="container mt-4">
        <div class="row justify-content-center mb-4">
            <div class="col-12 col-lg-10">
                <header class="text-center">
                    <div class="d-flex align-items-center justify-content-center gap-3 mb-3">
                        <span class="blog-category-badge">Programming</span>
                        <span class="blog-reading-time">
                            <i class="far fa-clock me-1"></i>
                            5 min read
                        </span>
                    </div>
                    <h1 id="blog-title" class="hero-title mb-4">@Model.BlogTitle</h1>
                    <div class="blog-meta d-flex justify-content-center align-items-center gap-4 text-muted small">
                        <span class="blog-author">
                            <i class="fas fa-user me-2"></i>
                            Ali Martin
                        </span>
                        <span>
                            <i class="far fa-calendar-alt me-1"></i>
                            @Model.BlogPublishDate.ToString("MMMM dd, yyyy")
                        </span>
                        <span>
                            <i class="far fa-eye me-1"></i>
                            @Model.Visit Views
                        </span>
                    </div>
                </header>
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-12 col-lg-10">
                <div class="glass-card overflow-hidden rounded-4">
                    <img src="/Blog/ThumnailsImage/@Model.BlogThumbnail"
                         class="img-fluid w-100 blog-featured-image"
                         alt="@Model.BlogTitle"
                         loading="lazy"
                         style="height: 500px; object-fit: cover;">
                </div>
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-12 col-lg-8">
                <div class="glass-card p-4 border-start border-4 border-primary">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-quote-left text-primary fs-3 me-3 mt-1"></i>
                        <p class="lead mb-0 fst-italic text-dark-emphasis">
                            @Model.BlogShortDescription
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <article class="blog-content glass-card p-5">
                    @Html.Raw(Model.BlogDescription)

                    <div class="mt-5 pt-4 border-top">
                        <h6 class="mb-3"><i class="fas fa-tags me-2"></i>Tags</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="blog-tag">ASP.NET</span>
                            <span class="blog-tag">Web Development</span>
                            <span class="blog-tag">Programming</span>
                            <span class="blog-tag">C#</span>
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-12 col-lg-4 mt-5 mt-lg-0">
                <div class="sticky-top" style="top: 100px;">
                    <div class="glass-card p-4 mb-4">
                        <h5 class="mb-4">About This Post</h5>
                        <ul class="list-unstyled">
                            <li class="mb-3">
                                <i class="fas fa-folder me-2 text-primary"></i>
                                <strong>Category:</strong> Technology
                            </li>
                            <li class="mb-3">
                                <i class="fas fa-calendar me-2 text-primary"></i>
                                <strong>Published:</strong> @Model.BlogPublishDate.ToString("MMMM dd, yyyy")
                            </li>
                            <li class="mb-3">
                                <i class="fas fa-clock me-2 text-primary"></i>
                                <strong>Reading Time:</strong> 5 minutes
                            </li>
                            <li class="mb-3">
                                <i class="fas fa-eye me-2 text-primary"></i>
                                <strong>Views:</strong> @Model.Visit
                            </li>
                        </ul>
                    </div>

                    <div class="glass-card p-4">
                        <h5 class="mb-4">Share This Post</h5>
                        <div class="social-share d-flex gap-3">
                            <a href="#" class="social-share-btn facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="#" class="social-share-btn twitter">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" class="social-share-btn linkedin">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="#" class="social-share-btn link">
                                <i class="fas fa-link"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-12 col-lg-8">
                <div class="d-flex justify-content-between align-items-center glass-card p-4">
                    <a href="/blogs/signalr-in-aspnet" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Previous Post
                    </a>
                    <a href="/blogs/dotnet-6-features" class="btn btn-outline-primary">
                        Next Post
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-auto">
                <a href="/blogs"
                   class="btn btn-primary btn-lg d-inline-flex align-items-center px-4 py-3">
                    <i class="fas fa-arrow-left me-3"></i>
                    Back to All Posts
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .blog-details-section {
        position: relative;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
    }

    .blog-category-badge {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        box-shadow: var(--shadow-sm);
    }

    .blog-reading-time {
        background: rgba(255, 255, 255, 0.9);
        color: var(--text-primary);
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .blog-author {
        display: inline-flex;
        align-items: center;
        background: rgba(78, 84, 200, 0.1);
        padding: 6px 16px;
        border-radius: 50px;
        color: var(--primary-color);
    }

    .hero-title {
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .blog-featured-image {
        transition: transform 0.5s ease;
    }

    .glass-card:hover .blog-featured-image {
        transform: scale(1.02);
    }

    .blog-content {
        line-height: 1.8;
        font-size: 1.125rem;
    }

        .blog-content h2 {
            font-size: 2rem;
            font-weight: 600;
            margin: 2.5rem 0 1.5rem;
            color: var(--primary-color);
            position: relative;
            padding-left: 1.5rem;
        }

            .blog-content h2::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0.5rem;
                bottom: 0.5rem;
                width: 4px;
                background: linear-gradient(180deg, var(--primary-color), var(--secondary-color));
                border-radius: 2px;
            }

        .blog-content h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 2rem 0 1rem;
            color: var(--text-primary);
        }

        .blog-content p {
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
        }

        .blog-content img {
            max-width: 100%;
            height: auto;
            border-radius: var(--radius-lg);
            margin: 2rem 0;
            box-shadow: var(--shadow-md);
        }

        .blog-content pre {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            overflow-x: auto;
            margin: 2rem 0;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .blog-content code {
            background: rgba(78, 84, 200, 0.1);
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            color: var(--primary-color);
        }

    .blog-tag {
        background: rgba(78, 84, 200, 0.1);
        color: var(--primary-color);
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }

        .blog-tag:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }

    .social-share-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
    }

        .social-share-btn.facebook {
            background: #1877f2;
        }

        .social-share-btn.twitter {
            background: #1da1f2;
        }

        .social-share-btn.linkedin {
            background: #0077b5;
        }

        .social-share-btn.link {
            background: var(--primary-color);
        }

        .social-share-btn:hover {
            transform: translateY(-4px) scale(1.1);
            box-shadow: var(--shadow-md);
        }

    .sticky-top {
        position: sticky;
        z-index: 10;
    }

    @@media (max-width: 992px) {
        .hero-title

    {
        font-size: 2.5rem;
    }

    .blog-featured-image {
        height: 350px;
    }

    .sticky-top {
        position: static;
    }

    }

    @@media (max-width: 768px) {
        .hero-title

    {
        font-size: 2rem;
    }

    .blog-featured-image {
        height: 300px;
    }

    .blog-content {
        padding: 2rem !important;
    }

    .blog-meta {
        flex-direction: column;
        gap: 1rem !important;
    }

    }
</style>